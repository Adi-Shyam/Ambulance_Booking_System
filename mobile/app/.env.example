EXPO_PUBLIC_API_URL=

# ---- Map tiles (F.4, F.8) ----
# MapTiler supplies the tiles. The key travels in the tile URL - it is a
# client-side key by design, and MapTiler restricts it by origin in their
# dashboard rather than by keeping it secret. Leave it empty and the map falls
# back to OpenStreetMap's own tiles, which work and look plainer.
#
# Geocoding and routing are unaffected: those are Nominatim and OSRM, called
# from the backend, and they need no key at all.
EXPO_PUBLIC_MAPTILER_KEY=

# ---- User manual ----
# Where the manual PDF can be opened from - a raw GitHub link to docs/ is
# enough. Empty shows a placeholder in the app's About panel instead of a
# button that opens nothing.
EXPO_PUBLIC_USER_MANUAL_URL=
