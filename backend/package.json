{
  "name": "abs-backend",
  "version": "1.0.0",
  "description": "Ambulance Booking System - REST + realtime backend (Team 16, IT303)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/seed.js --reset",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:system": "node --test \"tests/system/*.test.js\"",
    "test:report": "node tests/report.js",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/system/*.test.js\"",
    "smoke": "node tests/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
