# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated origins allowed to call the API (admin dashboard, Expo web)
CORS_ORIGIN=*

# ---- Auth (NF.3) ----
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=24h
# In development the OTP is returned in the API response so the apps can be tested
# without a live WhatsApp/SMS account. NEVER enable this in production.
EXPOSE_OTP_IN_RESPONSE=true

# ---- Dispatch engine (F.5 - F.7, C.6) ----
OFFER_TIMEOUT_SECONDS=45
MAX_DISPATCH_RETRIES=5
SEARCH_RADIUS_KM=15
# A driver whose app has not reported a position for this long is no longer
# dispatchable, and the recovery sweep marks them off duty.
PROVIDER_STALE_MINUTES=15

# ---- Recovery sweep (NF.1, C.6) ----
# Catches work that would otherwise be stranded: drivers who stop reporting,
# trips whose crew goes silent after accepting, and bookings left mid-match.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=60
TRIP_SILENCE_MINUTES=10

# ---- Reporting calendar (F.13) ----
# Analytics are bucketed by civil day and hour in this timezone. Stored
# timestamps remain UTC; only the report grouping is shifted. Default is IST.
REPORT_UTC_OFFSET=+05:30

# An EMG (emergency) request is offered to every nearby ambulance at once
# rather than down the ranked list one at a time. This caps how many alerts one
# request can produce in a dense area.
BROADCAST_LIMIT=10

# ---- Messaging / WhatsApp Business Cloud API (F.6, F.14) ----
# Leave WHATSAPP_TOKEN empty to run the mock transport: messages are persisted in
# the `messages` table and printed to the console instead of being sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_DISPATCH=ambulance_dispatch_alert
WHATSAPP_TEMPLATE_OTP=ambulance_otp
WHATSAPP_TEMPLATE_STATUS=ambulance_trip_status
# Business-initiated messages need an approved template. Leave this false to
# send plain text, which Meta accepts only inside the 24-hour window that
# opens when the recipient messages you first - enough for a test number.
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANGUAGE=en
DEFAULT_COUNTRY_CODE=91

# How many accounts one address may create in an hour (NF.3). A lab
# demonstration on one shared network looks like a single address to this
# limiter, so raise it if a room full of people are registering at once.
REGISTER_LIMIT_PER_HOUR=10

# ---- Email provider (F.1) ----
# brevo | smtp | mock. Leave empty and the first one with credentials wins,
# falling back to the mock transport when neither has any.
#
# Brevo is preferred for a hosted deployment: it is an outbound HTTPS call, so
# it works where an SMTP port may be blocked. Free tier is 300 emails a day.
# Get a key at app.brevo.com -> SMTP & API -> API keys, and make sure EMAIL_FROM
# uses a sender you have verified under Senders, Domains & Dedicated IPs.
EMAIL_PROVIDER=
BREVO_API_KEY=

# ---- Email delivery for verification codes (F.1) ----
# Phone stays the account identifier; this only decides where a code is sent,
# chosen per request with "channel": "EMAIL". Leave EMAIL_HOST empty to run the
# mock transport, which logs the code and writes the same `messages` row.
#
# Unlike WhatsApp, email has no 24-hour customer service window, needs no
# approved template and needs no billing relationship - so it is the channel
# that works without an account anywhere.
#
# Gmail: turn on 2-step verification, then create an App Password
# (myaccount.google.com/apppasswords) and use that as EMAIL_PASS. Your normal
# Google password will not authenticate over SMTP.
EMAIL_HOST=
EMAIL_PORT=587
# false for port 587 (STARTTLS), true for 465 (implicit TLS)
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Ambulance Booking System <your-verified-sender@example.com>

# ---- Maps / geocoding / routing (F.4, F.8) ----
# provider: osm (free, no key) | google (requires GOOGLE_MAPS_API_KEY)
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_CONTACT_EMAIL=team16@nitk.edu.in

# ---- Payments (F.10) ----
# provider: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay signs webhooks with a secret of its own, set per endpoint in the
# dashboard. It is not the API key secret above.
RAZORPAY_WEBHOOK_SECRET=

# ---- Fare rules (F.10) ----
TAX_PERCENT=5
