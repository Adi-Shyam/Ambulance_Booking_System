# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated origins allowed to call the API (admin dashboard, Expo web)
CORS_ORIGIN=*

# ---- Auth (NF.3) ----
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=24h
# In development the OTP is returned in the API response so the apps can be tested
# without a live WhatsApp/SMS account. NEVER enable this in production.
EXPOSE_OTP_IN_RESPONSE=true

# ---- Dispatch engine (F.5 - F.7, C.6) ----
OFFER_TIMEOUT_SECONDS=45
MAX_DISPATCH_RETRIES=5
SEARCH_RADIUS_KM=15
# A driver whose app has not reported a position for this long is no longer
# dispatchable, and the recovery sweep marks them off duty.
PROVIDER_STALE_MINUTES=15

# ---- Recovery sweep (NF.1, C.6) ----
# Catches work that would otherwise be stranded: drivers who stop reporting,
# trips whose crew goes silent after accepting, and bookings left mid-match.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=60
TRIP_SILENCE_MINUTES=10

# ---- Reporting calendar (F.13) ----
# Analytics are bucketed by civil day and hour in this timezone. Stored
# timestamps remain UTC; only the report grouping is shifted. Default is IST.
REPORT_UTC_OFFSET=+05:30

# ---- Messaging / WhatsApp Business Cloud API (F.6, F.14) ----
# Leave WHATSAPP_TOKEN empty to run the mock transport: messages are persisted in
# the `messages` table and printed to the console instead of being sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_DISPATCH=ambulance_dispatch_alert
WHATSAPP_TEMPLATE_OTP=ambulance_otp
WHATSAPP_TEMPLATE_STATUS=ambulance_trip_status
DEFAULT_COUNTRY_CODE=91

# ---- Maps / geocoding / routing (F.4, F.8) ----
# provider: osm (free, no key) | google (requires GOOGLE_MAPS_API_KEY)
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_CONTACT_EMAIL=team16@nitk.edu.in

# ---- Payments (F.10) ----
# provider: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Fare rules (F.10) ----
TAX_PERCENT=5
